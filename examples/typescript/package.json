{
  "name": "@marona/examples-agents-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable TypeScript examples for Marona Agents.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/src/cli.js",
    "test": "pnpm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "marona": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0"
  }
}
